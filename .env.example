APP_NAME="Community League"
APP_DISPLAY_TIMEZONE=Asia/Jakarta
ADMIN_DOMAIN=admin.communityleague.id
APP_TIMEZONE=UTC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=communityleague_local
DB_USERNAME=communityleague
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=16379

# Lokal: 'log' (email masuk storage/logs, tanpa kirim sungguhan).
# Staging/produksi: 'resend', RESEND_API_KEY diisi lewat .env server (deploy/.env.example) — jangan di repo.
MAIL_MAILER=log
RESEND_API_KEY=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://api-pay.sumopod.com/api/v1
SUMOPOD_WEBHOOK_TOKEN=
SUMOPOD_SANDBOX_BYPASS=false

MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Wajib subdomain send. — Resend memverifikasi send.communityleague.id, bukan domain utama (INFRA.md §10).
MAIL_FROM_ADDRESS="noreply@send.communityleague.id"
MAIL_FROM_NAME="Community League"

# Disk 'public' (foto match/reward item): 'local' di dev/CI, 's3' di staging/produksi (isi lewat
# .env server (deploy/.env.example), bukan di sini) supaya upload disimpan ke Cloudflare R2, bukan
# disk lokal container yang hilang tiap deploy. Lihat config/filesystems.php.
PUBLIC_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
