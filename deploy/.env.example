# Salin ke ~/communityleague/.env di VPS (chmod 600). Dibaca docker compose (interpolasi)
# DAN container app (env_file). DB_HOST/REDIS_HOST/LOG_CHANNEL di-set di docker-compose.yml.
# Nilai rahasia ada di VPS.md (PC) -- jangan pernah di-commit.

IMAGE_TAG=main
APP_PORT=8083

APP_NAME="Community League"
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://communityleague.id
ADMIN_DOMAIN=admin.communityleague.id
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_DATABASE=communityleague
DB_USERNAME=communityleague
# openssl rand -hex 24
DB_PASSWORD=

REDIS_CLIENT=predis
# openssl rand -hex 24
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@send.communityleague.id"
MAIL_FROM_NAME="Community League"
RESEND_API_KEY=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://communityleague.id/auth/google/callback

# Sementara masih SANDBOX Sumopod (domain sandbox + key sandbox). Ganti ke live = ganti 3 nilai ini.
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com/api/v1
SUMOPOD_WEBHOOK_TOKEN=
SUMOPOD_SANDBOX_BYPASS=false

# Gerbang akses + watermark SANDBOX. false = situs terbuka publik tanpa watermark.
SANDBOX_GATE_ENABLED=false

PUBLIC_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
